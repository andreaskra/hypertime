    },
    "destructive": {
      "light": "#C93832",
      "dark": "#FF6961"
    },
    "success": {
      "light": "#28A745",
      "dark": "#30D158"
    },
    "separator": {
      "light": "#00000017",
      "dark": "#FFFFFF1F",
      "highContrastLight": "#00000033",
      "highContrastDark": "#FFFFFF40"
    },
    "strokeGlassTop": {
      "light": "#FFFFFFB3",
      "dark": "#FFFFFF29"
    },
    "strokeGlassBottom": {
      "light": "#0000000D",
      "dark": "#0000004D"
    },
    "fieldBackground": {
      "light": "#FFFFFF99",
      "dark": "#FFFFFF17"
    },
    "rowHover": {
      "light": "#00000009",
      "dark": "#FFFFFF09"
    },
    "rowSelected": {
      "light": "accent@21%",
      "dark": "accent@29%"
    },
    "trackingIndicator": {
      "light": "#28A745",
      "dark": "#30D158"
    },
    "pausedIndicator": {
      "light": "#B08325",
      "dark": "#FFD60A"
    },
    "idleIndicator": {
      "light": "#00000073",
      "dark": "#FFFFFF73"
    },
    "invalidFieldBackground": {
      "light": "#FF453A21",
      "dark": "#FF453A2E"
    },
    "todayColumn": {
      "light": "accent@10%",
      "dark": "accent@16%"
    },
    "autoHideDrain": {
      "light": "#00000038",
      "dark": "#FFFFFF42"
    }
  },
  "material": {
    "panel": {
      "material": "hudWindow",
      "blending": "behindWindow",
      "tint": {
        "light": "#FFFFFF66",
        "dark": "#26262E99"
      },
      "fallback": {
        "light": "#F2F2F6",
        "dark": "#1E1E23"
      }
    },
    "panelPassive": {
      "material": "hudWindow",
      "blending": "behindWindow",
      "tint": {
        "light": "#FFFFFF40",
        "dark": "#26262E66"
      },
      "fallback": {
        "light": "#F2F2F6",
        "dark": "#1E1E23"
      }
    },
    "window": {
      "material": "underWindowBackground",
      "blending": "behindWindow",
      "tint": {
        "light": "#FAFAFDBF",
        "dark": "#2C2C34B8"
      },
      "fallback": {
        "light": "#F4F4F7",
        "dark": "#232329"
      }
    },
    "popover": {
      "material": "popover",
      "blending": "behindWindow",
      "tint": {
        "light": "#FCFCFFEB",
        "dark": "#32323ADD"
      },
      "fallback": {
        "light": "#FCFCFF",
        "dark": "#32323A"
      }
    },
    "sheet": {
      "material": "sheet",
      "blending": "withinWindow",
      "tint": {
        "light": "#FAFAFEDE",
        "dark": "#2E2E36D9"
      },
      "fallback": {
        "light": "#FAFAFE",
        "dark": "#2E2E36"
      }
    },
    "field": {
      "material": "none",
      "blending": "none",
      "tint": {
        "light": "#FFFFFF99",
        "dark": "#FFFFFF17"
      },
      "fallback": {
        "light": "#FFFFFF",
        "dark": "#2A2A31"
      }
    },
    "listHighlight": {
      "material": "none",
      "blending": "none",
      "tint": {
        "light": "accent@100%",
        "dark": "accent@100%"
      },
      "fallback": {
        "light": "accent",
        "dark": "accent"
      }
    }
  },
  "font": {
    "heading": {
      "family": "SF Pro Text",
      "size": 11,
      "weight": "medium",
      "tracking": 0,
      "tabular": false
    },
    "body": {
      "family": "SF Pro Text",
      "size": 13,
      "weight": "regular",
      "tracking": 0,
      "tabular": false
    },
    "caption": {
      "family": "SF Pro Text",
      "size": 10,
      "weight": "regular",
      "tracking": 0,
      "tabular": false
    },
    "timeAdd": {
      "family": "SF Pro Rounded",
      "size": 26,
      "weight": "medium",
      "tracking": 0.3,
      "tabular": true
    },
    "timeLarge": {
      "family": "SF Pro Rounded",
      "size": 28,
      "weight": "medium",
      "tracking": 0.3,
      "tabular": true
    },
    "timeCell": {
      "family": "SF Pro Text",
      "size": 12,
      "weight": "regular",
      "tracking": 0,
      "tabular": true
    },
    "listRow": {
      "family": "SF Pro Text",
      "size": 13,
      "weight": "regular",
      "tracking": 0,
      "tabular": false
    },
    "listRowCurrent": {
      "family": "SF Pro Text",
      "size": 13,
      "weight": "medium",
      "tracking": 0,
      "tabular": false
    },
    "periodTitle": {
      "family": "SF Pro Display",
      "size": 15,
      "weight": "semibold",
      "tracking": 0,
      "tabular": false
    },
    "menuBarTime": {
      "family": "SF Pro Text",
      "size": 11.5,
      "weight": "regular",
      "tracking": 0,
      "tabular": true
    },
    "keyboardHint": {
      "family": "SF Pro Text",
      "size": 10,
      "weight": "regular",
      "tracking": 0,
      "tabular": false
    }
  },
  "radius": {
    "panel": 18,
    "window": 12,
    "sheet": 12,
    "popover": 12,
    "field": 10,
    "button": 9,
    "row": 8,
    "cell": 6,
    "chip": 12,
    "kbdHint": 4
  },
  "space": {
    "1": 4,
    "2": 8,
    "3": 12,
    "4": 16,
    "5": 24
  },
  "size": {
    "popupWidth": 380,
    "popupWidthMax": 400,
    "popupMinHeight": 150,
    "popupMaxHeight": 320,
    "fieldHeight": 30,
    "buttonHeight": 28,
    "listRowHeight": 28,
    "dropdownRowHeight": 26,
    "todayListMaxVisibleRows": 6,
    "toolbarHeight": 52,
    "reportsDefault": [
      760,
      540
    ],
    "settingsWidth": 480
  },
  "shadow": {
    "panel": {
      "light": {
        "color": "#00000038",
        "blur": 40,
        "y": 12
      },
      "dark": {
        "color": "#0000008C",
        "blur": 40,
        "y": 12
      }
    },
    "panelPassive": {
      "light": {
        "color": "#00000026",
        "blur": 28,
        "y": 8
      },
      "dark": {
        "color": "#00000066",
        "blur": 28,
        "y": 8
      }
    },
    "popover": {
      "light": {
        "color": "#0000004D",
        "blur": 48,
        "y": 16
      },
      "dark": {
        "color": "#00000099",
        "blur": 48,
        "y": 16
      }
    },
    "window": {
      "light": {
        "color": "#00000047",
        "blur": 60,
        "y": 20
      },
      "dark": {
        "color": "#00000080",
        "blur": 60,
        "y": 20
      }
    }
  },
  "motion": {
    "popupAppearPassive": {
      "duration": 180,
      "curve": "easeOut",
      "note": "fade + 6pt slide down, no bounce"
    },
    "popupAppearFocused": {
      "duration": 180,
      "curve": "easeOut",
      "note": "same + scale from 0.98"
    },
    "popupDismiss": {
      "duration": 120,
      "curve": "easeIn",
      "note": "fade + 4pt up"
    },
    "listOpen": {
      "duration": 160,
      "curve": "easeOut",
      "note": "height anim, rows fade staggered <=30ms"
    },
    "highlightMove": {
      "duration": 90,
      "curve": "easeOut"
    },
    "digitTick": {
      "duration": 150,
      "curve": "linear",
      "note": "changed digit only, optional vertical roll"
    },
    "commit": {
      "duration": 250,
      "curve": "easeOut",
      "note": "confirm flash + dismiss, total budget"
    },
    "invalidShake": {
      "duration": 300,
      "curve": "easeInOut",
      "note": "2-cycle horizontal shake + invalid tint"
    },
    "pauseCrossfade": {
      "duration": 200,
      "curve": "easeInOut"
    },
    "discard": {
      "duration": 250,
      "curve": "easeIn",
      "note": "amount field collapses+clears 120ms, then popupDismiss 120ms"
    },
    "autoHide": {
      "duration": 20000,
      "curve": "linear",
      "note": "top-edge 2pt drain; hover/click cancels; ends in popupDismiss"
    },
    "reduceMotionFallback": {
      "duration": 120,
      "curve": "linear",
      "note": "every animation becomes a 120ms crossfade"
    }
  },
  "icons": {
    "pause": "pause.fill",
    "resume": "play.fill",
    "export": "square.and.arrow.up",
    "addProject": "plus",
    "navBack": "chevron.left",
    "navForward": "chevron.right",
    "dropdownChevron": "chevron.down",
    "settings": "gearshape",
    "reports": "chart.bar",
    "quit": "power",
    "menuBarGlyph": "custom (assets/menubar-*.svg)",
    "appIcon": "custom (assets/appicon.svg)"
  }
}