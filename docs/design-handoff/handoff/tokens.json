    "textTertiary": {
      "light": "#00000059",
      "dark": "#FFFFFF66",
      "highContrastLight": "#00000080",
      "highContrastDark": "#FFFFFF99"
    },
    "accent": {
      "light": "system:controlAccentColor",
      "dark": "system:controlAccentColor"
    },
    "onAccent": {
      "light": "#FFFFFF",
      "dark": "#FFFFFF"
    },
    "invalid": {
      "light": "#C93832",
